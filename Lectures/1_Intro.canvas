		{"id":"599b2e13a17578e6","type":"text","text":"\"No silver bullet\"\n\nProcedural modeling is usually used in combination with other modeling and rendering techniques.\n\n","x":-1700,"y":-2299,"width":484,"height":150,"color":"3"},
		{"id":"151ae4bb5a5c10dd","type":"text","text":"Sculpting-based modeling is sometimes better choice for 3D character creation.","x":-1862,"y":-1099,"width":809,"height":60},
		{"id":"c8905168538105ab","type":"text","text":"However, procedural modeling is great for character FX ","x":-963,"y":-1099,"width":501,"height":71,"color":"4"},
