		{"id":"4dea0d264a745751","type":"text","text":"**Modeling** e.g., for 3D printing","x":-1374,"y":4990,"width":315,"height":113},
		{"id":"8df254364aeab14d","type":"text","text":"Example: sparse voxel grid","x":-1304,"y":6113,"width":250,"height":60},
		{"id":"cdf6bb3a32a7338f","type":"text","text":"https://www.icare3d.org/research/GTC2012_Voxelization_public.pdf","x":-964,"y":6326,"width":400,"height":58},
		{"id":"818eb5a73d90ea5d","type":"file","file":"Images/Material/Tools/VoxelChunkStreaming.jpg","x":-964,"y":5701,"width":400,"height":205},
		{"id":"39e6cb9a8f926b2a","type":"file","file":"Images/Material/Tools/NVIDIA_GVDB_Density_Medical.jpg","x":-980,"y":5217,"width":400,"height":308},
