		{"id":"bc9fd3b3b7444bf0","type":"file","file":"Images/Fuzzy/LectureExamples/3/points.jpg","x":-2110,"y":1157,"width":652,"height":367},
		{"id":"d6571ca5d9fc672b","type":"file","file":"Images/Fuzzy/LectureExamples/5/SurfaceVectorField2.png","x":-4391,"y":1959,"width":576,"height":404},
