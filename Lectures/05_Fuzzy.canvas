		{"id":"0c920cee6db307bc","type":"text","text":"Rendering particles:\n* https://www.youtube.com/watch?v=5X8lwx69bQ4\n* https://www.sidefx.com/docs/houdini/solaris/kug/materials.html#emissive\n* https://www.sidefx.com/docs/houdini/solaris/kug/lights.html#geo","x":1320,"y":1497,"width":700,"height":173},
