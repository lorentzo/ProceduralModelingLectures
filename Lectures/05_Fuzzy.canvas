		{"id":"956fdfabf6fef8d0","type":"text","text":"**Update context**\n* Unity calls this every frame for all particles, and uses this to perform simulations, for example Forces and Collisions.","x":-11777,"y":11627,"width":250,"height":320,"color":"3"},
