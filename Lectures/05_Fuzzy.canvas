		{"id":"c91ab4723d11146e","type":"text","text":"# Procedural Modeling Lecture: Fuzzy Modeling\n\nDr.-Ing. Lovro Bosnar\nContact: lovro.bosnar@fer.hr\n","x":-19640,"y":123,"width":991,"height":147},
		{"id":"ddd0da0daa59afd1","type":"file","file":"Images/Fuzzy/Examples/DestinyParticles.jpg","x":-17116,"y":250,"width":527,"height":278},
