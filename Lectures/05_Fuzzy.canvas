		{"id":"72c1192038200b4d","type":"text","text":"Procedural characters","x":-17400,"y":660,"width":250,"height":60},
		{"id":"991535b7bbe2ac64","type":"file","file":"Images/Fuzzy/Examples/Fur1.jpg","x":-16541,"y":1100,"width":556,"height":386},
		{"id":"07bc0deef41c10eb","type":"text","text":"Characters and character FX","x":-17793,"y":376,"width":271,"height":78},
		{"id":"4c5222a662df5bd9","type":"text","text":"Character secondary animation","x":-17400,"y":166,"width":250,"height":60},
		{"id":"b6f58aeb61564638","type":"file","file":"Images/Fuzzy/Examples/DestinyParticles2.jpg","x":-16549,"y":214,"width":498,"height":332},
