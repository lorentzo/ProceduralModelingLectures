	"nodes":[
		{"id":"e237c5b9391ed9df","type":"text","text":"Blender examples","x":1311,"y":-938,"width":250,"height":60},
		{"id":"8d23a8db29edc24b","type":"text","text":"* Force fields and RBD:\n\t* https://www.youtube.com/watch?v=3dbKvSjTzQI\n\t* https://www.youtube.com/watch?v=efAR6MglkYM\n\t* https://www.youtube.com/watch?v=ziguVXsc3yk\n\t* https://www.youtube.com/watch?v=BS_QBh-X5TU\n* Tips and tricks:\n\t* https://www.youtube.com/watch?v=xOnIAxuBjHs\n* Filling space with RBD:\n\t* https://www.youtube.com/watch?v=89jxLu2etas\n\t* https://www.youtube.com/watch?v=jS02paw1WdE\n* Voronoi fracture:\n\t* https://www.youtube.com/watch?v=FIPu9_OGFgc\n\t* https://www.youtube.com/watch?v=jD6bUp9icjQ","x":1098,"y":-703,"width":677,"height":420},
