		{"id":"599b2e13a17578e6","type":"text","text":"\"No silver bullet\"\n\nProcedural modeling is usually used in combination with other modeling and rendering techniques.\n\n","x":300,"y":-2302,"width":484,"height":150,"color":"3"},
