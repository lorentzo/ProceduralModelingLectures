		{"id":"dbf801fa4695c2c4","type":"text","text":"https://vimeo.com/824101376","x":-9855,"y":-1107,"width":294,"height":60},
		{"id":"26bdc2ddfb0f6148","type":"text","text":"**Generation step**: fixed parameters\n* Final model, an instance, is generated once parameters are set","x":-11100,"y":-1866,"width":573,"height":140},
		{"id":"9554cc3bbb09de8c","type":"text","text":"* Parametric model offers number of parameters determining its shape/color/animation, etc.","x":-11780,"y":-1760,"width":549,"height":77},
		{"id":"71087710fde7c92f","type":"text","text":"# What is procedural modeling?","x":-11880,"y":-2320,"width":572,"height":66},
