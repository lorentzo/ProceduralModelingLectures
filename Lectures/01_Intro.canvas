		{"id":"1a5c0140ca9ce0fd","type":"text","text":"**Procedural implementation** is specific to DCC, in this case Houdini.","x":10740,"y":-1652,"width":270,"height":159},
		{"id":"b389e98e646bdb3a","type":"text","text":"**Procedural concepts** can be applied to any DCC which supports procedural modeling.","x":10300,"y":-1652,"width":280,"height":159},
