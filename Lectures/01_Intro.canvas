		{"id":"d845d00f6be661c7","type":"file","file":"Images/Tessellation/LectureExamples/1.JPG","x":3801,"y":1037,"width":400,"height":346},
		{"id":"a11e6407ecd3cb20","type":"text","text":"Procedural modeling is maybe not the best choice for:","x":1680,"y":-1962,"width":326,"height":80,"color":"1"},
		{"id":"460561e385579df4","type":"file","file":"Images/Material/LectureExamples/1/r1 3.jpg","x":3860,"y":520,"width":355,"height":355},
		{"id":"400fb013875ab829","type":"text","text":"UI for direct manual access to each geometry element is requirement.","x":1880,"y":-1065,"width":652,"height":50},
		{"id":"d9cb202c1222bf60","type":"text","text":"Manual and/or destructive modeling","x":2480,"y":-1434,"width":324,"height":74,"color":"2"},
		{"id":"c8905168538105ab","type":"text","text":"However, procedural modeling is great for character FX ","x":1037,"y":-1102,"width":501,"height":71,"color":"4"},
		{"id":"379651079f55c59a","type":"file","file":"Images/Intro/NotBestApps/PixarCharacters.jpg","x":1037,"y":-1031,"width":501,"height":471},
		{"id":"227d45ca9349d6a1","type":"text","text":"Bender: https://www.instructables.com/Methods-of-Selection-in-Edit-Mode-of-Blender/","x":1880,"y":-560,"width":652,"height":57},
		{"id":"e7ecc578078adb17","type":"text","text":"However, procedural modeling is great for creating tools to speed up manual modeling!","x":2731,"y":-1042,"width":560,"height":65,"color":"4"},
