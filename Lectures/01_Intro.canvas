		{"id":"0c44970b0c01c02c","type":"text","text":"Installing Houdini.\n\n1. Create free account.\n2. Install Launcher: https://www.sidefx.com/download/\n3. Install Houdini using Launcher\n4. Install Labs using Launcher\n5. Select Apprentice licence (free non-commercial)","x":13190,"y":-2051,"width":660,"height":286},
		{"id":"10052ac63938dde1","type":"text","text":"File -> New Project...","x":13473,"y":-841,"width":250,"height":60},
		{"id":"5de1e2284667b3f7","type":"link","url":"https://polyhaven.com/","x":14300,"y":869,"width":700,"height":325},
		{"id":"f85d3fb0a9735dc5","type":"text","text":"Import 3D models using `geo/` or `geo/obj/` network\n\nSupported file formats: https://www.sidefx.com/docs/houdini/io/formats/index.html\n* OBJ\n* FBX\n* GLTF\n* USD\n* Alembic\n","x":13801,"y":869,"width":374,"height":325},
		{"id":"b851ca4679272c0b","type":"file","file":"Images/Intro/HoudiniFirstSteps/1_BuildDesktop.jpg","x":12858,"y":-112,"width":1553,"height":833},
		{"id":"f36a9c27d4b8a97d","type":"text","text":"Create `geo/` network for creating and editing 3D models","x":13359,"y":1001,"width":250,"height":103},
