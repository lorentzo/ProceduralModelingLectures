		{"id":"a50291bb2d3463dc","type":"text","text":"Procedural DCC Tools","x":-14277,"y":3167,"width":250,"height":60},
		{"id":"944a209623cf79fb","type":"text","text":"https://www.motionforgepictures.com/height-maps/","x":-14404,"y":4410,"width":480,"height":59},
		{"id":"499a269c548cb3b6","type":"text","text":"Animation","x":-13416,"y":3771,"width":250,"height":60},
		{"id":"49af7ab08b5a4ae5","type":"text","text":"Props - trees, stones, grass, etc.","x":-16078,"y":2581,"width":945,"height":51},
		{"id":"3b42207f0e42a0a5","type":"text","text":"What is the goal and for which application? For example:\n* I need **snow biome terrain** for **real time strategy PC game**\n* I need **green hills biome** with roads for **3D racing Console game** \n* I need **low poly desert biome** for **2.5D mobile casual game**\n* I need **abstract sci-fi biome** for **motion graphics animation**\n* I need **terrain with sea and small islands** for **animated film**","x":-13751,"y":-400,"width":679,"height":216},
		{"id":"6437b53652c2c48a","type":"text","text":"Artistic references","x":-12938,"y":36,"width":250,"height":60},
