		{"id":"81e955ab0b102246","type":"text","text":"Base materijal - colors, textures, reflectivity, etc.","x":-17101,"y":2581,"width":927,"height":50},
		{"id":"b26cd296582dc68c","type":"text","text":"\n* Modeling terrain requires to distinguish features from references and concept art\n* Features have to be classified, simplified and then modeled","x":-16720,"y":1869,"width":449,"height":140,"color":"3"},
		{"id":"490e51106ec948dc","type":"text","text":"https://www.artstation.com/artwork/D4kL0","x":-16520,"y":1475,"width":393,"height":51},
		{"id":"1eab9c3c8a86f007","type":"file","file":"Images/Noise/LectureExamples/3/MeshNoiseDisplacement_Step4.jpg","x":-17101,"y":2631,"width":927,"height":422},
		{"id":"4a6d3a4edaa0776e","type":"file","file":"Images/Noise/Workflow/design.jpg","x":-12651,"y":1841,"width":634,"height":441},
		{"id":"e06443f4a30bae8a","type":"text","text":"* Decide on procedural modeling toolset\n\t* Convenient and fast for modeling and easy to re-iterate\n* Decide on representation primitive\n\t* Simplify modeling and ensure it runs on target device\n* Decide on amount of detail\n\t* Optimize performance and visual goal","x":-13251,"y":1948,"width":520,"height":226},
		{"id":"801956b120c5ebaa","type":"text","text":"https://www.artstation.com/artwork/nEORGX","x":-16520,"y":928,"width":442,"height":54},
